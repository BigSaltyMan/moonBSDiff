import {
  "BigSaltyMan/moonbsdiff",
  "BigSaltyMan/moonbsdiff/internal/bzip2",
  "BigSaltyMan/moonbsdiff/internal/manifest" @manifest_support,
  "BigSaltyMan/moonbsdiff/manifest",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
  "moonbitlang/core/priority_queue",
  "moonbitstack/mooncrypt/hash/sha2",
}

supported_targets = "-all+native"

pkgtype(kind: "executable")

options(
  "native-stub": [ "native_io.c" ],
)
