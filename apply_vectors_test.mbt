///|
test "apply-upstream-all-bytes" {
  let old = apply_fixture_9_old()
  let patch = apply_fixture_9_patch()
  let old_snapshot = old.to_array()
  let patch_snapshot = patch.to_array()
  let limits = apply_limits()
  let result = @moonbsdiff.apply(old, patch, limits)
  assert_eq(result, Ok(apply_fixture_9_new()))
  assert_eq(old.to_array(), old_snapshot)
  assert_eq(patch.to_array(), patch_snapshot)
  assert_eq(
    @moonbsdiff.apply(b"", apply_fixture_0_patch(), apply_limits()),
    Ok(b""),
  )
}

