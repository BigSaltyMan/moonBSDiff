  assert_eq(old.to_array(), old_snapshot)
  assert_eq(patch.to_array(), patch_snapshot)
  assert_eq(
    @moonbsdiff.apply(b"", apply_fixture_0_patch(), apply_limits()),
    Ok(b""),
  )
}

