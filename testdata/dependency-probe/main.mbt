    ),
  ]
  for (name, plain_hex, reference_hex) in vectors {
    let plain = try! @base16.decode(plain_hex[:])
    let reference = try! @base16.decode(reference_hex[:])
    let decoded = try! @bzip2.bunzip2(reference[:], limit=200000)
    try! assert_eq(decoded, plain)
    let packed = @bzip2.bzip2(plain[:], level=1)
    let roundtrip = try! @bzip2.bunzip2(packed[:], limit=200000)
    try! assert_eq(roundtrip, plain)
    println(name + ":" + @base16.encode(packed[:]))
  }
