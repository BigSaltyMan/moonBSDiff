    Ok(b""),
  )
}

///|
fn boundary_patch_25() -> Bytes {
  b"\x42\x53\x44\x49\x46\x46\x34\x30\x0e\x00\x00\x00\x00\x00\x00\x00\x0e\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x42\x5a\x68\x39\x17\x72\x45\x38\x50\x90\x00\x00\x00\x00\x42\x5a" +
  b"\x68\x39\x17\x72\x45\x38\x50\x90\x00\x00\x00\x00\x42\x5a\x68\x39\x17\x72\x45\x38\x50\x90\x00\x00\x00\x00\x21"
}

///|
test "apply-boundary-empty-extra-trailing" {
  let patch = boundary_patch_25()
  let snapshot = patch.to_array()
  match @moonbsdiff.apply(b"", patch, @moonbsdiff.Limits::for_apply()) {
    Ok(_) => abort("strict patch accepted")
    Err(e) => {
      assert_eq(e.kind, InvalidField)
      assert_eq(e.stage, Extra)
      assert_eq(e.block, Some("extra"))
      assert_eq(e.field, Some("trailing data after single bzip2 stream"))
      assert_eq(e.offset, Some(74L))
    }
  }
  assert_eq(patch.to_array(), snapshot)
  assert_eq(
    @moonbsdiff.apply(
      b"",
      apply_fixture_0_patch(),
      @moonbsdiff.Limits::for_apply(),
    ),
    Ok(b""),
  )
}

